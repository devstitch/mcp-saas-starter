{
  "name": "mcp-saas-starter",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:rls": "pnpm --filter @mcp-saas-starter/database test",
    "test:authz": "pnpm --filter @mcp-saas-starter/authorization test",
    "dev:mcp": "pnpm --filter @mcp-saas-starter/mcp-server dev",
    "db:seed": "pnpm --filter @mcp-saas-starter/database db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
