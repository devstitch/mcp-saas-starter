# Supabase (web + MCP server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# MCP server
# Origin clients use. For ChatGPT, set this to the tunnel origin (https://something.ngrok.app).
# That hostname is then allowed in addition to localhost.
MCP_SERVER_URL=http://127.0.0.1:3001
HOST=127.0.0.1
PORT=3001
