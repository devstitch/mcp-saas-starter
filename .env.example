# Supabase (web app and MCP server)
# Project URL, for example https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable (anon) key. Safe to expose to the browser. The web app inlines only this and SUPABASE_URL.
SUPABASE_PUBLISHABLE_KEY=
# Service-role key. Server only. Used for seed, audit inserts, and deleting a task after approval.
# Never commit a real value. Never add this key to Next.js `env` inlining.
SUPABASE_SECRET_KEY=

# MCP server
# Public origin clients use to reach this server. Do not append /mcp.
# Local default is below. For a tunnel, set the tunnel origin (https://something.example.com).
# That hostname is then allowed in addition to localhost.
MCP_SERVER_URL=http://127.0.0.1:3001
# Interface the MCP process binds to.
# Use 127.0.0.1 for pnpm dev on your machine.
# Docker Compose sets 0.0.0.0 so the published port can reach the process.
HOST=127.0.0.1
# Port the MCP process listens on.
PORT=3001

# Rate limiting. Unset or memory uses the in-process limiter (fine for one local server).
# Set redis only when RATE_LIMIT_REDIS_URL is also set. Required together in production
# if more than one MCP process is running.
# RATE_LIMIT_STORE=memory
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379
