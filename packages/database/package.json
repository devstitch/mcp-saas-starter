{
  "name": "@mcp-saas-starter/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "db:seed": "tsx seed/seed.ts"
  },
  "devDependencies": {
    "dotenv": "^18.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0"
  }
}
