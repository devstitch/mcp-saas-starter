              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 11,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_project\",\n    \"arguments\": {\n      \"projectId\": \"{{projectId}}\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{mcpBaseUrl}}/mcp"
          }
        },
