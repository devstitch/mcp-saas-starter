        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" },
              { "key": "MCP-Protocol-Version", "value": "{{protocolVersion}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 14,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"create_task\",\n    \"arguments\": {\n      \"projectId\": \"{{projectId}}\",\n      \"title\": \"Postman task\",\n      \"description\": \"Created from the MCP SaaS Starter collection.\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{mcpBaseUrl}}/mcp",
            "description": "Member or admin. A viewer is denied. Saves the new task id into taskId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function saveVar(key, value) {",
                  "  pm.collectionVariables.set(key, value);",
                  "  try { pm.environment.set(key, value); } catch (error) {}",
                  "}",
                  "function mcpMessage(text) {",
                  "  const trimmed = (text || '').trim();",
                  "  if (!trimmed) return null;",
                  "  if (trimmed.startsWith('{') || trimmed.startsWith('[')) return JSON.parse(trimmed);",
                  "  const dataLine = trimmed.split(/\\r?\\n/).filter((line) => line.startsWith('data:')).map((line) => line.slice(5).trim()).filter(Boolean).pop();",
                  "  return dataLine ? JSON.parse(dataLine) : null;",
                  "}",
                  "function toolJson(message) {",
                  "  const text = message && message.result && message.result.content && message.result.content[0] && message.result.content[0].text;",
                  "  if (!text) return null;",
                  "  try { return JSON.parse(text); } catch (error) { return null; }",
                  "}",
                  "const created = toolJson(mcpMessage(pm.response.text()));",
                  "pm.test('create_task returns a task', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(created).to.be.an('object');",
                  "  pm.expect(created.id).to.be.a('string');",
                  "});",
                  "if (created && created.id) saveVar('taskId', created.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" },
              { "key": "MCP-Protocol-Version", "value": "{{protocolVersion}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 15,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"update_task\",\n    \"arguments\": {\n      \"taskId\": \"{{taskId}}\",\n      \"title\": \"Postman task (updated)\",\n      \"status\": \"in_progress\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{mcpBaseUrl}}/mcp",
            "description": "At least one of title, description, status, or assigneeId is required. status must be a permitted transition from the current value. A new task starts as todo, so in_progress is valid."
          }
        },
        {
          "name": "Assign task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" },
              { "key": "MCP-Protocol-Version", "value": "{{protocolVersion}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 16,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"assign_task\",\n    \"arguments\": {\n      \"taskId\": \"{{taskId}}\",\n      \"assigneeId\": \"{{assigneeId}}\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{mcpBaseUrl}}/mcp",
            "description": "assigneeId must be a member of the same organization. Sign-in stores the signed-in user id."
          }
        },
        {
          "name": "Delete task (pending approval)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" },
              { "key": "MCP-Protocol-Version", "value": "{{protocolVersion}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 17,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"delete_task\",\n    \"arguments\": {\n      \"taskId\": \"{{taskId}}\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{mcpBaseUrl}}/mcp",
            "description": "Admin only. Does not delete the task. Returns pending_approval. Approve or reject it in the web app at /dashboard/approvals. Members and viewers are denied and no pending row is created."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function mcpMessage(text) {",
                  "  const trimmed = (text || '').trim();",
                  "  if (!trimmed) return null;",
                  "  if (trimmed.startsWith('{') || trimmed.startsWith('[')) return JSON.parse(trimmed);",
                  "  const dataLine = trimmed.split(/\\r?\\n/).filter((line) => line.startsWith('data:')).map((line) => line.slice(5).trim()).filter(Boolean).pop();",
                  "  return dataLine ? JSON.parse(dataLine) : null;",
                  "}",
                  "function toolJson(message) {",
                  "  const text = message && message.result && message.result.content && message.result.content[0] && message.result.content[0].text;",
                  "  if (!text) return null;",
                  "  try { return JSON.parse(text); } catch (error) { return null; }",
                  "}",
                  "const result = toolJson(mcpMessage(pm.response.text()));",
                  "pm.test('delete stays pending', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(result.status).to.eql('pending_approval');",
                  "  pm.expect(result.protectedActionId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
