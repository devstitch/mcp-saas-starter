    {
      "name": "Tools",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" },
              { "key": "MCP-Protocol-Version", "value": "{{protocolVersion}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 10,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_projects\",\n    \"arguments\": {\n      \"limit\": 20\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{mcpBaseUrl}}/mcp",
            "description": "Saves projectId from the first project in the signed-in organization."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function saveVar(key, value) {",
                  "  pm.collectionVariables.set(key, value);",
                  "  try { pm.environment.set(key, value); } catch (error) {}",
                  "}",
                  "function mcpMessage(text) {",
                  "  const trimmed = (text || '').trim();",
                  "  if (!trimmed) return null;",
                  "  if (trimmed.startsWith('{') || trimmed.startsWith('[')) return JSON.parse(trimmed);",
                  "  const dataLine = trimmed.split(/\\r?\\n/).filter((line) => line.startsWith('data:')).map((line) => line.slice(5).trim()).filter(Boolean).pop();",
                  "  return dataLine ? JSON.parse(dataLine) : null;",
                  "}",
                  "function toolJson(message) {",
                  "  const text = message && message.result && message.result.content && message.result.content[0] && message.result.content[0].text;",
                  "  if (!text) return null;",
                  "  try { return JSON.parse(text); } catch (error) { return null; }",
                  "}",
                  "const projects = toolJson(mcpMessage(pm.response.text()));",
                  "pm.test('list_projects returns projects', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(projects).to.be.an('array').that.is.not.empty;",
                  "});",
                  "if (Array.isArray(projects) && projects[0] && projects[0].id) {",
                  "  saveVar('projectId', projects[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" },
