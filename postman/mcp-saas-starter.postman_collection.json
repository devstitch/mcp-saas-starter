            "url": "{{mcpBaseUrl}}/mcp",
            "description": "Expect 401 and a WWW-Authenticate challenge pointing at the protected-resource metadata."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing token is rejected', function () {",
                  "  pm.response.to.have.status(401);",
